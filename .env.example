# ==========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==========================================
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (MYSQL)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=finanzas_personales

# ==========================================
# SEGURIDAD Y CORS
# ==========================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:8000"]

# ==========================================
# AUTENTICACION (JWT)
# ==========================================
# SECRET_KEY firma los tokens de acceso. Quien la conozca puede emitir tokens
# validos para CUALQUIER usuario, asi que NUNCA debe versionarse ni compartirse.
#
# Este archivo es solo una plantilla: el valor de abajo es un marcador de
# posicion, no una clave real. Genera la tuya con:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# En desarrollo puede omitirse: la aplicacion genera una clave efimera en cada
# arranque (los tokens dejan de valer al reiniciar). En produccion es
# obligatoria y el arranque se aborta si falta.
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_DE_64_CARACTERES

# Algoritmo de firma del JWT.
ALGORITHM=HS256

# Minutos de validez del token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=60
